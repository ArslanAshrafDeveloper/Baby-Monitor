# Signaling backend env

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Symmetric secret used to sign device JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production_please_change_me

# TURN server configuration. Leave TURN_SECRET blank in dev to use only public STUN.
TURN_HOST=turn.example.com
TURN_REALM=babymonitor
TURN_SECRET=

# Firebase Cloud Messaging server key (for Android pushes; iOS uses APNs via FCM in dev).
FCM_SERVER_KEY=

# Comma-separated origins allowed to call the REST API in dev.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
